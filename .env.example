# ==============================================================================
# ShardSphere Environment Configuration
# ==============================================================================

# Cluster Identity
CLUSTER_NAME=ShardSphere-Cluster-Alpha
ENVIRONMENT=production

# Coordinator Configuration
COORDINATOR_ID=coordinator-primary-1
COORDINATOR_PORT=8000
COORDINATOR_HOST=0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_USER=shardsphere
POSTGRES_PASSWORD=shardsphere_secure_dev_pass
POSTGRES_DB=shardsphere
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://shardsphere:shardsphere_secure_dev_pass@postgres:5432/shardsphere
DATABASE_URL_SYNC=postgresql://shardsphere:shardsphere_secure_dev_pass@postgres:5432/shardsphere

# Distributed Storage Settings
REPLICATION_FACTOR=3
DEFAULT_CHUNK_SIZE_BYTES=1048576
MAX_FILE_SIZE_BYTES=5368709120

# Failure Detection & Heartbeats (Seconds)
HEARTBEAT_INTERVAL_SECONDS=2
MISSED_HEARTBEATS_SUSPECT=3
FAILURE_THRESHOLD_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=2.0

# Leader Election & Lease Coordination (Seconds)
LEASE_DURATION_SECONDS=10
LEASE_RENEW_INTERVAL_SECONDS=3

# Storage Nodes Registered URLs (Comma-separated name:url)
STORAGE_NODES=storage-node-1:http://storage-node-1:8001,storage-node-2:http://storage-node-2:8002,storage-node-3:http://storage-node-3:8003,storage-node-4:http://storage-node-4:8004,storage-node-5:http://storage-node-5:8005

# Frontend Configuration
FRONTEND_PORT=3000
VITE_COORDINATOR_API_URL=http://localhost:8000
